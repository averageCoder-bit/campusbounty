# Never commit a real private key. Use an isolated, funded TESTNET wallet only.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_PRIVATE_KEY
# Optionally issue from a different authorized issuer wallet (setIssuer must authorize it).
BSC_ISSUER_PRIVATE_KEY=0xYOUR_TESTNET_ISSUER_PRIVATE_KEY
BSC_ACHIEVEMENT_CONTRACT=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
DEMO_STUDENT_WALLET=0xSTUDENT_WALLET_ADDRESS
# Optional: source verification via Hardhat / Etherscan V2.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
